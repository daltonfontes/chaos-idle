<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- The Godot client. Keep the SDK version equal to the Godot editor version used in CI.
       net9.0: Godot 4.7's Android export templates only support .NET 9. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>ChaosIdle.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/ChaosIdle.App/ChaosIdle.App.csproj" />
  </ItemGroup>
</Project>
