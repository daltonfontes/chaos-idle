<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- C# 9 records need this type, which netstandard2.1 (and Unity) lacks. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)src/Shared/IsExternalInit.cs" Link="Shared/IsExternalInit.cs" />
  </ItemGroup>
</Project>
