# Copy to .env (never commit .env) and fill in.

# The server's address. Point its DNS A/AAAA record at this machine before starting.
DOMAIN=api.example.com
# Let's Encrypt writes here about certificate problems.
ACME_EMAIL=you@example.com

# A long random password (e.g. `openssl rand -base64 32`). Set it once: the database keeps the first one.
POSTGRES_PASSWORD=change-me

# The OAuth Web client id from Google Cloud (docs/google-sign-in.md). Empty: Google sign-in off.
GOOGLE_WEB_CLIENT_ID=

# Optional
# SERVER_IMAGE=ghcr.io/daltonfontes/chaos-idle-server:latest
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
# RATE_LIMIT_ACCOUNT_PER_MINUTE=120
# BACKUP_KEEP_DAYS=14
